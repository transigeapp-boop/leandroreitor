{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/estudantes",
      "destination": "/#seg-estudantes",
      "permanent": false
    },
    {
      "source": "/servidores",
      "destination": "/#seg-servidores",
      "permanent": false
    },
    {
      "source": "/terceirizados",
      "destination": "/#seg-terceirizados",
      "permanent": false
    },
    {
      "source": "/propostas",
      "destination": "/#propostas",
      "permanent": false
    },
    {
      "source": "/moldura",
      "destination": "/#moldura",
      "permanent": false
    },
    {
      "source": "/participe",
      "destination": "/#participe",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
